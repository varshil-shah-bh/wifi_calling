NODE_ENV=development
PORT=4000

# Local Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wifi_calling
PGSSL=false

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma separated, or * during local development
CORS_ORIGIN=*
